# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary and backup files
*.tmp
*.temp
*.bak

# Local environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Generic build output
build/
dist/
out/

# Debian live-build working directories and generated artifacts
.build/
cache/
chroot/
chroot.*
binary/
binary.*
source/
source.*

# Generated disk and virtual-machine images
*.iso
*.img
*.raw
*.qcow2
*.vdi
*.vmdk

# Generated live-build configuration
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source
/config/package-lists/live.list.chroot

# Standard hooks generated by live-build
/config/hooks/live/*.hook.chroot
/config/hooks/normal/*.hook.chroot

# Verifas-owned hooks remain versionable
!/config/hooks/live/*-verifas-*.hook.chroot
!/config/hooks/normal/*-verifas-*.hook.chroot

# Generated image metadata and checksums
/*.contents
/*.files
/*.packages
/*.iso.sha256
/wget-log*
