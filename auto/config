#!/bin/sh

set -eu

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --binary-image iso-hybrid \
    --bootloaders "syslinux grub-efi" \
    --debian-installer none \
    --archive-areas "main" \
    --apt-secure true \
    --security true \
    --updates true \
    --backports false \
    --checksums sha256 \
    --source false \
    --uefi-secure-boot auto \
    --image-name "verifas-os-dev" \
    --iso-application "Verifas OS Development" \
    --iso-publisher "Verifas Project" \
    --iso-volume "VERIFAS_OS_DEV" \
    --bootappend-live "boot=live components username=verifas hostname=verifas-os" \
    "${@}"
